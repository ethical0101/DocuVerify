LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Optional: JWT signing secret for enterprise auth. If unset, one is generated
# automatically on first run and persisted to data/.jwt_secret (gitignored).
JWT_SECRET=

# Optional: point at a managed Postgres instead of the local SQLite file, e.g.
# postgresql://user:password@host:5432/docuverify -- no other code change
# needed, SQLAlchemy handles both dialects against the same models. Leave
# unset to keep using SQLite (the default for local dev).
DATABASE_URL=

# Optional: store uploaded documents in a Cloudflare R2 bucket instead of the
# container's local (ephemeral) disk, so they survive restarts/redeploys
# without needing a paid persistent disk. All four must be set together, or
# uploads fall back to local disk exactly as before. Enterprise dataset ZIPs
# and trained model files are NOT yet covered by this and still need a
# persistent disk if you're using those features in production.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
